<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:background="#222831"

    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:id="@+id/welcome"
                android:textColor="#DFD0B8"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintBottom_toTopOf="@id/text"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/otfsmb"

                />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up to get access"
            android:textSize="20sp"
            android:id="@+id/text"
            android:textColor="#DFD0B8"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toTopOf="@id/card"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/otfr"

            />



        <androidx.cardview.widget.CardView
            android:layout_width="294dp"
            android:layout_height="459dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/black"
            android:outlineSpotShadowColor="@color/black"
            android:alpha="0.09"
            android:layout_marginTop="15dp"
            ></androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card"
            android:layout_width="290dp"
            android:layout_height="450dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="#393E46"
             android:outlineSpotShadowColor="@color/black">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center"
                android:orientation="vertical"

                android:padding="16dp"
                android:gravity="top|center">
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />
                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/roundedrec"
                    android:hint="Username"
                    android:drawableStart="@drawable/person"
                    android:textColorHint="#948979"
                    android:textSize="15sp"
                    android:fontFamily="@font/otfr" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/roundedrec"
                    android:hint="Password"
                    android:textColorHint="#948979"
                    android:textSize="15sp"
                    android:drawableStart="@drawable/lock"
                    android:inputType="textPassword"
                    android:fontFamily="@font/otfr" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <ImageButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/info"
                    android:layout_gravity="center"
                    android:alpha="1"
                    android:id="@+id/info"
                    />

            </LinearLayout>
            </androidx.cardview.widget.CardView>




    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.drawerlayout.widget.DrawerLayout>